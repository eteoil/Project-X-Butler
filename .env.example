# Copy this file to .env and fill in real values. Never commit .env.

# X (Twitter) login credentials
X_USERNAME=
X_PASSWORD=

# Set to "false" to allow real posts/likes. Defaults to "true" (test mode) when unset.
TEST_MODE=true

# Optional: Google Sheets-backed configuration.
# Path to a Google service account JSON key file with read access to the sheet.
GOOGLE_SERVICE_ACCOUNT_FILE=./config/service-account.json
# Spreadsheet ID from its URL, only needed when config/config.json has googleSheets.enabled=true.
GOOGLE_SPREADSHEET_ID=
